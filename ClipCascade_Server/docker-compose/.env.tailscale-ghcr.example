# Copy to .env next to docker-compose.tailscale-ghcr.yml, then edit.
#
# .env is gitignored; this example is not. Keep real addresses and secrets in
# .env only.

# Prebuilt multi-arch image. Pin a tag or digest for production rather than
# tracking :latest.
CLIPCASCADE_IMAGE=ghcr.io/ysalitrynskyi/clipcascade:latest

# This host's Tailscale address: tailscale ip -4
CC_BIND_ADDRESS=100.64.0.1

# Every exact origin you will actually open, comma separated. Add the MagicDNS
# name too if you browse via *.ts.net. A wildcard is refused at startup.
CC_ALLOWED_ORIGINS=http://100.64.0.1:8080

# H2 with CIPHER=AES: "<file password> <user password>". The space is required.
#
# Migrating an existing volume? This MUST be the password the files were created
# with, or the database will not open. If you never set it on
# sathvikrao/clipcascade:latest, it was the upstream baked-in default — see
# docs/MIGRATE_EXISTING_DOCKER.md — and you should rotate it once the migration
# is verified, since that value is public.
CC_SERVER_DB_PASSWORD=<file-password> <user-password>

# First boot only, when the user table is empty. Leave commented when migrating
# an existing volume.
# CC_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

CC_MAX_MESSAGE_SIZE_IN_MiB=100
CC_P2P_ENABLED=false
CC_SIGNUP_ENABLED=false
CC_UPDATE_CHECK_ENABLED=false

# Older releases kept sessions for about a year; the default is now 24h.
# Uncomment to keep the old behaviour.
# CC_SESSION_TIMEOUT=525960m

TZ=UTC
JAVA_TOOL_OPTIONS=-Xmx4g -Xms512m
CC_MEM_LIMIT=6g
